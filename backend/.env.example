# Fixora backend configuration.
# Copy to .env and fill in the blanks: cp backend/.env.example backend/.env
# Values shown after "default:" are what the code falls back to when unset.

# ---------- Core ----------
NODE_ENV=development
PORT=5001

# ---------- Database (required) ----------
# The server exits on startup if it cannot reach MongoDB. There is no mongo
# service in docker-compose.dev.yml, so point this at Atlas or your own host.
# MONGO_URL and MONGO_CONNECTION_STRING are accepted as fallbacks.
MONGO_URI=
MONGO_DB=serviceProvider

# ---------- Auth (required) ----------
# Use a long random string, e.g. openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
VERIFY_LINK_EXPIRES_MIN=60

# ---------- URLs / CORS ----------
# CORS_ORIGINS is a comma-separated allowlist.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- Redis ----------
# Backs the rate limiter. Matches the redis service in docker-compose.dev.yml.
REDIS_URL=redis://:redis123@localhost:6379

# ---------- Admin seed (npm run seed) ----------
ADMIN_EMAIL=admin@fixora.com
ADMIN_PASSWORD=

# ---------- Email ----------
# EMAIL_PROVIDER: gmail | sendgrid | both        (default: gmail)
EMAIL_PROVIDER=gmail
APP_NAME=Fixora
APP_FROM_EMAIL=
# Required when EMAIL_PROVIDER is gmail or both. Use a Google App Password,
# not your account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Required when EMAIL_PROVIDER is sendgrid or both.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---------- Payments ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Third party ----------
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
