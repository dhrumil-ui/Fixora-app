# Fixora frontend configuration.
# Copy to .env and fill in the blanks: cp frontend/.env.example frontend/.env
# Only VITE_-prefixed variables are exposed to the browser bundle, so never
# put a secret key in here.

# Backend REST base and Socket.io origin.
VITE_API_BASE=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001

# Publishable (pk_) key only.
VITE_STRIPE_PUBLIC_KEY=

# Browser-key for the maps JS SDK; restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
